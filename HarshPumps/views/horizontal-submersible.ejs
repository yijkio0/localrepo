    <script>
        const sliders=['mmb-slider','hsps-slider','hp-slider']
        sliders.forEach(className=>{
            new Swiper(`.${className}`,{
                loop:true,
                autoplay:{
                    delay:2500,
                    disableOnInteraction:false 
                },
                pagination:{
                    el:'.swiper-pagination',
                    clickable:true 
                }
            })
        })
