    <style>
        .series-flex{
            display:flex;
            flex-wrap:wrap;
            justify-content:center;
            gap:6rem;
        }
        .series-group{
            flex:1 1 100%;
            max-width:100%;    
        }
        .series-container{
            display:flex;
            flex-wrap:wrap;
            gap:1.5rem;
            justify-content:center;
        }
        .series-card{
            width:100%;
            max-width:900px;
            flex:1 1 800px;
            margin:0 auto;
        }
    </style>
    <script>
        function toggleDetails(id){
            const el=document.getElementById(id)
            el.classList.toggle('hidden')
        }
    </script>
