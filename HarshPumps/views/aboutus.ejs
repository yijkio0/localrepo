    <script>
        const observer=new IntersectionObserver(
            entries=>{
                entries.forEach(entry=>{
                    if(entry.isIntersecting){
                        entry.target.classList.add('show')
                    }
                })
            },
            {threshold:0.1}
        )
        document.querySelectorAll('.fade-up').forEach(e1=>observer.observe(e1))
    </script>
